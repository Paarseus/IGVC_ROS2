Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    # Coarse grid only. Under llvmpipe every grid line is CPU-rasterised, so
    # this is 25x25 at 20 m rather than the old 60x60 at 50 m.
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 20
      Plane Cell Count: 25
      Alpha: 0.3
      Color: 90; 90; 90
      Value: true

    # Campus roads. Publisher decimates this (edges only, range-limited) --
    # see route_graph_viz.py.
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: RouteGraph
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /route_graph
      Value: true

    # The planned route, drawn before you confirm the drive.
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: RoutePreview
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /auto_drive/route_preview
      Color: 255; 40; 40
      Line Style: Billboards
      Line Width: 1.2
      Value: true

    # Live vehicle pose. Covariance ellipse deliberately OFF: it is a
    # per-frame transparent mesh and costs real time in software GL, while
    # telling us nothing we act on here.
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Vehicle
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry/global
      Position Tolerance: 0.5
      Angle Tolerance: 0.5
      Keep: 1
      Shape:
        Value: Arrow
        Alpha: 1
        Head Length: 1.6
        Head Radius: 0.9
        Shaft Length: 3
        Shaft Radius: 0.35
        Color: 0; 255; 0
      Covariance:
        Position:
          Value: false
        Orientation:
          Value: false
      Value: true

    # NOTE: the TF display is intentionally absent. It rendered every frame on
    # the robot (3 ZEDs x several optical frames, velodyne, imu, base_link,
    # odom, map) WITH name labels every frame -- expensive under llvmpipe and
    # an unreadable pile of overlapping text at any sensible zoom. The green
    # Odometry arrow above already shows pose and heading. Add TF back
    # temporarily if you ever need to debug frames.

  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: map
    # 5 Hz, not the default 30. This is a map you click on, not something you
    # need smooth animation from; it roughly halves RViz's CPU draw cost.
    Frame Rate: 5
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/PublishPoint
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Views:
    Current:
      Class: rviz_default_plugins/XYOrbit
      Name: Current View
      Target Frame: base_link
      Distance: 60
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.5707
      Yaw: 0.0
      Near Clip Distance: 0.01
      Invert Z Axis: false
Window Geometry:
  Height: 800
  Width: 1200
  X: 60
  Y: 60
