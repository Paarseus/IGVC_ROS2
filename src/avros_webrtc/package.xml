<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>avros_webrtc</name>
  <version>0.0.0</version>
  <description>Low-latency teleop video: ROS image topic -> Jetson NVENC H.264 -> MediaMTX (WebRTC/WHEP)</description>
  <maintainer email="avlab@cpp.edu">AV Lab</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-gi</exec_depend>
  <!-- GStreamer runtime (apt, not rosdep): see scripts/install_deps.sh.
       NVIDIA nvvidconv / nvv4l2h264enc ship with JetPack (nvidia-l4t-gstreamer). -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
