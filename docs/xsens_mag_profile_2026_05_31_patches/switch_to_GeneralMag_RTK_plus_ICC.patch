diff --git a/src/avros_bringup/config/xsens.yaml b/src/avros_bringup/config/xsens.yaml
index 738a517..bcde1df 100644
--- a/src/avros_bringup/config/xsens.yaml
+++ b/src/avros_bringup/config/xsens.yaml
@@ -12,7 +12,7 @@ xsens_mti_node:
     frame_id: "imu_link"
 
     # Output rate
-    enable_deviceConfig: false     # 2026-05-30: GNSS_LeverArm (0.74 m) already flashed (nav ran clean to wp 5004). Back to false so it stops re-flashing the MTi firmware every boot. Set true ONCE only when changing a flashed device param (lever arm, filter profile).
+    enable_deviceConfig: true      # MAG-PROFILE FLASH (2026-05-31): true for ONE boot to write the filter profile + ICC flag to the MTi, then REVERT to false (see docs/xsens_mag_profile_2026_05_31_patches/README.md). Prior note: GNSS_LeverArm (0.74 m) flashed 2026-05-30; set true ONLY when changing a flashed device param (lever arm, filter profile, option flags).
     output_data_rate: 100          # Hz
 
     # Publishers
@@ -54,3 +54,14 @@ xsens_mti_node:
     enable_orientation_smoother: true
     enable_position_velocity_smoother: true
     enable_continuous_zero_rotation_update: true
+
+    # --- MAG-AIDED HEADING (staged 2026-05-31; apply ONLY if General_RTK fails to converge at driving speed) ---
+    # Switch filter profile General_RTK(0) -> GeneralMag_RTK(2) so the magnetometer is fused for an absolute
+    # heading even at rest/low speed. Requires enable_deviceConfig: true above for ONE flash boot.
+    # MTi-680G profile indices: 0 = General_RTK, 1 = GeneralNoBaro_RTK, 2 = GeneralMag_RTK.
+    enable_filter_config: true
+    mti_filter_option: 2
+    # In-run Compass Calibration: set the onboard mag-cal option flag, then DRIVE figure-8s / loops through
+    # varied headings so the device self-calibrates (replaces the PC Magnetic Field Mapper — no MT Manager needed).
+    # NOTE: ICC/MFM correct static hard/soft-iron only; they do NOT cancel motor-current (dynamic) distortion.
+    enable_inrun_compass_calibration: true
