[Unit]
Description=AVROS WebUI (ROS2 phone joystick + actuator)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dinosaur
Group=dinosaur
WorkingDirectory=/home/dinosaur/IGVC
Environment=HOME=/home/dinosaur
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
Environment=CYCLONEDDS_URI=file:///home/dinosaur/IGVC/install/avros_bringup/share/avros_bringup/config/cyclonedds.xml
ExecStartPre=/bin/bash -c 'fuser -k 8000/tcp 2>/dev/null; sleep 1; exit 0'
ExecStart=/bin/bash -c 'source /opt/ros/humble/setup.bash && source /home/dinosaur/IGVC/install/setup.bash && exec ros2 launch avros_bringup webui.launch.py'
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
