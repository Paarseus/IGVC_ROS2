{"post_stream":{"posts":[{"id":3130736,"name":"Ryan zheng","username":"Rzheng1232","avatar_template":"/user_avatar/www.chiefdelphi.com/rzheng1232/{size}/182897_2.png","created_at":"2023-01-20T19:33:31.769Z","cooked":"\u003cp\u003eHelp, I have to configure our swerve drivetrain variables using the wpilib SysId but I have no idea how to use it. I didn’t find much tutorials online and I didn’t really understand the page on WPILib docs.\u003cbr\u003e\nThanks!\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":14,"updated_at":"2023-01-20T19:33:31.769Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":1004,"reads":293,"readers_count":292,"score":5078.6,"yours":false,"topic_id":424060,"topic_slug":"sysid-help","display_username":"Ryan zheng","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":true,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":55168,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"user_custom_fields":{"user_field_4":"Programmer"},"post_url":"/t/sysid-help/424060/1","custom_user_title":"Programmer","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":true,"can_vote":false},{"id":3130754,"name":"Tyler Veness","username":"calcmogul","avatar_template":"/user_avatar/www.chiefdelphi.com/calcmogul/{size}/128045_2.png","created_at":"2023-01-20T19:52:44.801Z","cooked":"\u003cp\u003eSysId is primarily intended for identification of differential drive and appendage models. It’s not designed for swerve drive. You can abuse the tool to get some of the information you want though.\u003c/p\u003e\n\u003cp\u003eYou can characterize the two degrees of freedom of a swerve drive module by locking the module rotation with a piece of wood or something for the linear test, and spinning the module in place for the rotation test.\u003c/p\u003e\n\u003cp\u003eNote that swerve module system ID is different from whole-drivetrain system ID.\u003c/p\u003e","post_number":2,"post_type":1,"posts_count":14,"updated_at":"2023-01-20T19:54:51.748Z","reply_count":3,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":16,"reads":281,"readers_count":280,"score":151.2,"yours":false,"topic_id":424060,"topic_slug":"sysid-help","display_username":"Tyler Veness","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":true,"can_wiki":false,"link_counts":[{"url":"https://www.chiefdelphi.com/t/how-to-find-correct-constants-for-swerve-drive/424473/2","internal":true,"reflection":true,"title":"How to find correct constants for swerve drive","clicks":13}],"read":true,"user_title":"","bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":16846,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"user_custom_fields":{"user_field_4":"WPILib controls | Choreo/Sleipnir"},"post_url":"/t/sysid-help/424060/2","custom_user_title":"WPILib controls | Choreo/Sleipnir","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":true,"topic_accepted_answer":true},{"id":3130941,"name":"Ryan zheng","username":"Rzheng1232","avatar_template":"/user_avatar/www.chiefdelphi.com/rzheng1232/{size}/182897_2.png","creat